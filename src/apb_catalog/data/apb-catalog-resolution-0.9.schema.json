{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "description": "One entry compatible with a request, and the requested qualifiers it leaves unknown.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "qualifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "object"
        },
        "undecided": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Undecided",
          "type": "array"
        }
      },
      "required": [
        "entry_id",
        "reference",
        "key",
        "kind",
        "qualifiers"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CatalogueDescription": {
      "additionalProperties": false,
      "description": "What one catalogue set holds and who uses it.",
      "properties": {
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "used_by": {
          "items": {
            "type": "string"
          },
          "title": "Used By",
          "type": "array"
        }
      },
      "required": [
        "purpose",
        "used_by"
      ],
      "title": "CatalogueDescription",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Why a reviewer assigned an entry's meaning.",
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "basis"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FieldRequest": {
      "additionalProperties": false,
      "description": "A consumer's question: one level, constrained by a kind and accepted qualifier values.\n\n``key`` names the access key asked for and ``kind`` the kind it stands for, ``None`` when the\nrequest spans every key; ``qualifiers`` hold the values the key fixes, plus any further\nqualifiers the caller asked for. Qualifiers left out accept any value. A request for a key\nanswers with that key's entries; an entry of another key only keeps it undecided. An entry whose\nreviewer could not establish a qualifier is undecided unless the request accepts ``unknown``\nthere. A ``var`` request also reads feature-aligned ``varm`` tables.",
      "properties": {
        "level": {
          "title": "Level",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "qualifiers": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Qualifiers",
          "type": "object"
        }
      },
      "required": [
        "level"
      ],
      "title": "FieldRequest",
      "type": "object"
    },
    "LevelBinding": {
      "discriminator": {
        "mapping": {
          "produced": "#/$defs/ProducedBinding",
          "reviewed": "#/$defs/ReviewedBinding",
          "unreviewed": "#/$defs/UnreviewedBinding"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReviewedBinding"
        },
        {
          "$ref": "#/$defs/ProducedBinding"
        },
        {
          "$ref": "#/$defs/UnreviewedBinding"
        }
      ]
    },
    "Location": {
      "enum": [
        "obs",
        "layers",
        "var",
        "varm"
      ],
      "type": "string"
    },
    "ProducedBinding": {
      "additionalProperties": false,
      "description": "A level of a set without vendor catalogues: only apps' and annotations' fields answer.",
      "properties": {
        "status": {
          "const": "produced",
          "default": "produced",
          "title": "Status",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "software_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Software Name"
        },
        "software_version_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Software Version Pattern"
        }
      },
      "required": [
        "level",
        "software_name",
        "software_version_pattern"
      ],
      "title": "ProducedBinding",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "The package and version that wrote a snapshot.",
      "properties": {
        "package": {
          "title": "Package",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "Qualifier": {
      "additionalProperties": false,
      "description": "One dimension of a set's meanings and the meanings of its admitted values, ``unknown``\namong them once it has any.",
      "properties": {
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "definition",
        "values"
      ],
      "title": "Qualifier",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "Where one field lives in an APB result: by its APB output name or a prefix.\n\nA ``varm`` field also names its feature-aligned table. An ``obs`` field of a sample\nannotation is named by the prefix of its column name and bound to the column a level holds\nbefore it answers.",
      "properties": {
        "level": {
          "title": "Level",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        }
      },
      "required": [
        "level",
        "location"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Requirement": {
      "enum": [
        "required",
        "recommended",
        "optional"
      ],
      "type": "string"
    },
    "Resolution": {
      "additionalProperties": false,
      "description": "The answer to one request; only ``resolved`` carries a reference.\n\n``requirement`` records the requirement a missing field had when the catalog enforced it at\ninit.",
      "properties": {
        "request": {
          "$ref": "#/$defs/FieldRequest"
        },
        "status": {
          "$ref": "#/$defs/ResolutionStatus"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Requirement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request",
        "status"
      ],
      "title": "Resolution",
      "type": "object"
    },
    "ResolutionStatus": {
      "enum": [
        "resolved",
        "missing",
        "ambiguous",
        "unknown"
      ],
      "type": "string"
    },
    "ReviewedBinding": {
      "additionalProperties": false,
      "description": "A level whose rule's software and version match a reviewed catalogue variant.",
      "properties": {
        "status": {
          "const": "reviewed",
          "default": "reviewed",
          "title": "Status",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "software_name": {
          "title": "Software Name",
          "type": "string"
        },
        "software_version_pattern": {
          "title": "Software Version Pattern",
          "type": "string"
        }
      },
      "required": [
        "level",
        "software_name",
        "software_version_pattern"
      ],
      "title": "ReviewedBinding",
      "type": "object"
    },
    "SetVocabulary": {
      "additionalProperties": false,
      "description": "What one set's entries mean: its kinds, and the qualifiers that refine a kind.\n\nAn entry has one kind and a value for every qualifier; ``unknown`` is among every qualifier's\nvalues once there are any. A set declared without kinds is being planned: it loads, with\nnothing to answer. ``prefix`` asks the set alone, as ``c:q_value``.",
      "properties": {
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "kind_definition": {
          "title": "Kind Definition",
          "type": "string"
        },
        "kinds": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Kinds",
          "type": "object"
        },
        "qualifiers": {
          "additionalProperties": {
            "$ref": "#/$defs/Qualifier"
          },
          "title": "Qualifiers",
          "type": "object"
        }
      },
      "required": [
        "prefix",
        "definition",
        "kind_definition",
        "kinds",
        "qualifiers"
      ],
      "title": "SetVocabulary",
      "type": "object"
    },
    "SourceEntry": {
      "additionalProperties": false,
      "description": "The reviewed meaning of one retained field for the listed software version patterns.\n\n``key`` is the access key the entry names; ``kind`` is that key's kind, and ``qualifiers``\nhold the entry's value for every other qualifier of the set, the key's fixed value included.",
      "properties": {
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "software_version_pattern": {
          "items": {
            "type": "string"
          },
          "title": "Software Version Pattern",
          "type": "array"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "qualifiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Qualifiers",
          "type": "object"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "entry_id",
        "software_version_pattern",
        "reference",
        "key",
        "kind",
        "qualifiers",
        "evidence"
      ],
      "title": "SourceEntry",
      "type": "object"
    },
    "UnreviewedBinding": {
      "additionalProperties": false,
      "description": "A level no catalogue describes, and why.",
      "properties": {
        "status": {
          "const": "unreviewed",
          "default": "unreviewed",
          "title": "Status",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "software_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Software Name"
        },
        "software_version_pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Software Version Pattern"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "level",
        "software_name",
        "software_version_pattern",
        "reason"
      ],
      "title": "UnreviewedBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Level bindings, the retained entries they supply, and the answers to consumer requests.",
  "properties": {
    "contract": {
      "const": "apb-catalog-resolution",
      "default": "apb-catalog-resolution",
      "title": "Contract",
      "type": "string"
    },
    "contract_version": {
      "const": "0.9",
      "default": "0.9",
      "title": "Contract Version",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "catalogue": {
      "title": "Catalogue",
      "type": "string"
    },
    "description": {
      "$ref": "#/$defs/CatalogueDescription"
    },
    "vocabulary_version": {
      "title": "Vocabulary Version",
      "type": "string"
    },
    "vocabulary": {
      "$ref": "#/$defs/SetVocabulary"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/LevelBinding"
      },
      "title": "Levels",
      "type": "array"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SourceEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "resolutions": {
      "items": {
        "$ref": "#/$defs/Resolution"
      },
      "title": "Resolutions",
      "type": "array"
    }
  },
  "required": [
    "producer",
    "catalogue",
    "description",
    "vocabulary_version",
    "vocabulary",
    "levels",
    "entries",
    "resolutions"
  ],
  "title": "ResolutionSnapshot",
  "type": "object"
}
